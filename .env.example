# Database
DATABASE_URL="postgresql://courier:courier@localhost:5432/courier"
DATABASE_URL_UNPOOLED="postgresql://courier:courier@localhost:5432/courier"

# First admin account created by the seed (admin@example.com)
SEED_ADMIN_PASSWORD="admin12345"
# Set to "false" to skip demo users, shipments and tariffs
SEED_DEMO="true"

# Session signing secret (any long random string)
AUTH_SECRET="change-me-to-a-long-random-string"

# Public site URL (used in emails and Telegram links)
APP_URL="http://localhost:3000"

# Automatic status sync
SYNC_INTERVAL_MINUTES=30
CRON_SECRET="change-me"

# Carrier APIs (leave empty to disable a carrier)
DHL_API_KEY=""
FEDEX_CLIENT_ID=""
FEDEX_CLIENT_SECRET=""
FEDEX_API_URL="https://apis.fedex.com"
UPS_CLIENT_ID=""
UPS_CLIENT_SECRET=""
UPS_API_URL="https://onlinetools.ups.com"
TRACK17_API_KEY=""

# Email notifications (SMTP)
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Express Cargo <no-reply@example.com>"

# Telegram bot (create with @BotFather)
TELEGRAM_BOT_TOKEN=""
TELEGRAM_BOT_USERNAME=""
TELEGRAM_WEBHOOK_SECRET=""
